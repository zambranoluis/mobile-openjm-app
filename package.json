{
  "name": "mobile-openjm-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src tests scripts",
    "typecheck": "node scripts/routes.mjs && tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "export": "expo export --platform all",
    "instructions:generate": "node scripts/instructions.mjs --write",
    "docs:check": "node scripts/instructions.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "inventory:web": "node scripts/inventory-web.mjs",
    "check": "npm run docs:check && npm run contract:check && npm run legal:check && npm run assets:check && npm run math:check && npm run locales:check && npm run lint && npm run typecheck && npm test && npm run test:unit",
    "locales:check":"node scripts/locales.mjs",
    "math:check": "node scripts/math-assets.mjs",
    "legal:generate": "node scripts/legal.mjs --write",
    "legal:check": "node scripts/legal.mjs",
    "assets:check": "node scripts/assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
